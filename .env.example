# ==============================================================================
# ENVIRONMENT VARIABLES: SUPABASE INTEGRATION
# ==============================================================================
# Salin file ini menjadi .env.local untuk development lokal
# Masukkan nilai berikut di Dashboard Vercel (Project Settings -> Environment Variables)

# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key Supabase (didapat dari Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
